<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="construction_crossing_scenario">
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>

    <gravity>0 0 -9.81</gravity>
    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.55 0.75 0.95 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <pose>0 0 15 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry><plane><normal>0 0 1</normal><size>30 18</size></plane></geometry>
        </collision>
        <visual name="ground_visual">
          <geometry><plane><normal>0 0 1</normal><size>30 18</size></plane></geometry>
          <material><ambient>0.45 0.35 0.22 1</ambient><diffuse>0.55 0.42 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Green transport lane and yellow crossing are visual experiment cues. -->
    <model name="transport_lane">
      <static>true</static><pose>5.5 0 0.006 0 0 0</pose>
      <link name="lane_link"><visual name="lane_visual">
        <geometry><box><size>11 2.2 0.01</size></box></geometry>
        <material><ambient>0.05 0.55 0.12 0.65</ambient><diffuse>0.05 0.7 0.15 0.65</diffuse></material>
        <transparency>0.35</transparency>
      </visual></link>
    </model>
    <model name="crossing_zone">
      <static>true</static><pose>7.5 0 0.014 0 0 0</pose>
      <link name="crossing_link"><visual name="crossing_visual">
        <geometry><box><size>2.5 6 0.012</size></box></geometry>
        <material><ambient>0.95 0.65 0.02 0.55</ambient><diffuse>1 0.72 0.02 0.55</diffuse></material>
        <transparency>0.45</transparency>
      </visual></link>
    </model>
    <model name="goal_marker">
      <static>true</static><pose>11 0 0.035 0 0 0</pose>
      <link name="goal_link"><visual name="goal_visual">
        <geometry><cylinder><radius>0.35</radius><length>0.05</length></cylinder></geometry>
        <material><ambient>0.1 0.25 0.95 1</ambient><diffuse>0.1 0.25 0.95 1</diffuse></material>
      </visual></link>
    </model>

    <!-- Minimal static construction context, kept away from the robot route. -->
    <model name="concrete_barrier_left">
      <static>true</static><pose>6 3.8 0.5 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>3 0.5 1</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>3 0.5 1</size></box></geometry>
      <material><ambient>0.55 0.55 0.52 1</ambient><diffuse>0.65 0.65 0.62 1</diffuse></material></visual></link>
    </model>
    <model name="material_stack_right">
      <static>true</static><pose>8 -4 0.45 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>2.5 1.2 0.9</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>2.5 1.2 0.9</size></box></geometry>
      <material><ambient>0.55 0.25 0.06 1</ambient><diffuse>0.7 0.32 0.08 1</diffuse></material></visual></link>
    </model>
    <model name="site_column">
      <static>true</static><pose>11 4 1.5 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.6 0.6 3</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.6 0.6 3</size></box></geometry>
      <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual></link>
    </model>

    <!-- Primitive worker: physics-safe placeholder for a later Blender asset. -->
    <model name="construction_worker">
      <static>true</static><pose>7.5 -3 0 0 0 1.57079632679</pose>
      <link name="worker_link">
        <visual name="dynamic_caution_zone"><pose>0 0 0.006 0 0 0</pose>
          <geometry><cylinder><radius>3.0</radius><length>0.006</length></cylinder></geometry>
          <material><ambient>1 0.72 0.02 0.18</ambient><diffuse>1 0.75 0.02 0.18</diffuse></material>
          <transparency>0.82</transparency>
        </visual>
        <visual name="dynamic_safety_zone"><pose>0 0 0.018 0 0 0</pose>
          <geometry><cylinder><radius>1.5</radius><length>0.012</length></cylinder></geometry>
          <material><ambient>0.95 0.02 0.02 0.35</ambient><diffuse>1 0.03 0.03 0.35</diffuse></material>
          <transparency>0.65</transparency>
        </visual>
        <collision name="body_collision"><pose>0 0 1.05 0 0 0</pose>
          <geometry><cylinder><radius>0.22</radius><length>1.1</length></cylinder></geometry>
        </collision>
        <visual name="legs"><pose>0 0 0.45 0 0 0</pose>
          <geometry><cylinder><radius>0.16</radius><length>0.9</length></cylinder></geometry>
          <material><ambient>0.05 0.12 0.55 1</ambient><diffuse>0.05 0.15 0.7 1</diffuse></material>
        </visual>
        <visual name="vest"><pose>0 0 1.15 0 0 0</pose>
          <geometry><box><size>0.45 0.28 0.65</size></box></geometry>
          <material><ambient>1 0.35 0.02 1</ambient><diffuse>1 0.45 0.02 1</diffuse></material>
        </visual>
        <visual name="head"><pose>0 0 1.65 0 0 0</pose>
          <geometry><sphere><radius>0.18</radius></sphere></geometry>
          <material><ambient>0.65 0.4 0.25 1</ambient><diffuse>0.75 0.5 0.3 1</diffuse></material>
        </visual>
        <visual name="helmet"><pose>0 0 1.8 0 0 0</pose>
          <geometry><sphere><radius>0.2</radius></sphere></geometry>
          <material><ambient>1 0.75 0.02 1</ambient><diffuse>1 0.8 0.02 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Only the active safety beacon is moved above the robot at runtime. -->
    <model name="safety_beacon_go">
      <static>true</static><pose>0 0 -2 0 0 0</pose>
      <link name="link"><visual name="visual">
        <geometry><sphere><radius>0.22</radius></sphere></geometry>
        <material><ambient>0.02 1 0.02 1</ambient><diffuse>0.02 1 0.02 1</diffuse><emissive>0.02 1 0.02 1</emissive></material>
      </visual></link>
    </model>
    <model name="safety_beacon_slow">
      <static>true</static><pose>0 0 -2 0 0 0</pose>
      <link name="link"><visual name="visual">
        <geometry><sphere><radius>0.22</radius></sphere></geometry>
        <material><ambient>1 0.8 0.02 1</ambient><diffuse>1 0.8 0.02 1</diffuse><emissive>1 0.8 0.02 1</emissive></material>
      </visual></link>
    </model>
    <model name="safety_beacon_stop">
      <static>true</static><pose>0 0 -2 0 0 0</pose>
      <link name="link"><visual name="visual">
        <geometry><sphere><radius>0.22</radius></sphere></geometry>
        <material><ambient>1 0.02 0.02 1</ambient><diffuse>1 0.02 0.02 1</diffuse><emissive>1 0.02 0.02 1</emissive></material>
      </visual></link>
    </model>
    <model name="safety_beacon_wait">
      <static>true</static><pose>0 0 -2 0 0 0</pose>
      <link name="link"><visual name="visual">
        <geometry><sphere><radius>0.22</radius></sphere></geometry>
        <material><ambient>1 0.8 0.02 1</ambient><diffuse>1 0.8 0.02 1</diffuse><emissive>1 0.8 0.02 1</emissive></material>
      </visual></link>
    </model>
    <model name="safety_beacon_resume">
      <static>true</static><pose>0 0 -2 0 0 0</pose>
      <link name="link"><visual name="visual">
        <geometry><sphere><radius>0.22</radius></sphere></geometry>
        <material><ambient>0.02 1 0.02 1</ambient><diffuse>0.02 1 0.02 1</diffuse><emissive>0.02 1 0.02 1</emissive></material>
      </visual></link>
    </model>
    <model name="safety_beacon_goal_reached">
      <static>true</static><pose>0 0 -2 0 0 0</pose>
      <link name="link"><visual name="visual">
        <geometry><sphere><radius>0.22</radius></sphere></geometry>
        <material><ambient>0.02 1 0.02 1</ambient><diffuse>0.02 1 0.02 1</diffuse><emissive>0.02 1 0.02 1</emissive></material>
      </visual></link>
    </model>

    <model name="minimal_robot">
      <pose>0 0 0.11 0 0 0</pose>
      <link name="chassis">
        <pose>0 0 0.10 0 0 0</pose>
        <inertial><mass>5.0</mass><inertia><ixx>0.0435</ixx><iyy>0.0727</iyy><izz>0.1042</izz></inertia></inertial>
        <collision name="chassis_collision"><geometry><box><size>0.4 0.3 0.12</size></box></geometry></collision>
        <visual name="chassis_visual"><geometry><box><size>0.65 0.42 0.16</size></box></geometry>
          <material><ambient>0.95 0.55 0.02 1</ambient><diffuse>0.95 0.6 0.02 1</diffuse></material></visual>
        <visual name="payload"><pose>-0.08 0 0.19 0 0 0</pose><geometry><box><size>0.38 0.32 0.2</size></box></geometry>
          <material><ambient>0.18 0.18 0.18 1</ambient><diffuse>0.22 0.22 0.22 1</diffuse></material></visual>
      </link>
      <link name="left_wheel">
        <pose>0 0.18 0 1.57079632679 0 0</pose>
        <inertial><mass>0.5</mass><inertia><ixx>0.00135</ixx><iyy>0.00135</iyy><izz>0.0025</izz></inertia></inertial>
        <collision name="collision"><geometry><cylinder><radius>0.1</radius><length>0.05</length></cylinder></geometry>
          <surface><friction><ode><mu>1</mu><mu2>1</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><cylinder><radius>0.1</radius><length>0.05</length></cylinder></geometry></visual>
      </link>
      <link name="right_wheel">
        <pose>0 -0.18 0 1.57079632679 0 0</pose>
        <inertial><mass>0.5</mass><inertia><ixx>0.00135</ixx><iyy>0.00135</iyy><izz>0.0025</izz></inertia></inertial>
        <collision name="collision"><geometry><cylinder><radius>0.1</radius><length>0.05</length></cylinder></geometry>
          <surface><friction><ode><mu>1</mu><mu2>1</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><cylinder><radius>0.1</radius><length>0.05</length></cylinder></geometry></visual>
      </link>
      <link name="rear_caster">
        <pose>-0.15 0 -0.06 0 0 0</pose><inertial><mass>0.1</mass><inertia><ixx>0.000064</ixx><iyy>0.000064</iyy><izz>0.000064</izz></inertia></inertial>
        <collision name="collision"><geometry><sphere><radius>0.04</radius></sphere></geometry><surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface></collision>
      </link>
      <link name="front_caster">
        <pose>0.15 0 -0.06 0 0 0</pose><inertial><mass>0.1</mass><inertia><ixx>0.000064</ixx><iyy>0.000064</iyy><izz>0.000064</izz></inertia></inertial>
        <collision name="collision"><geometry><sphere><radius>0.04</radius></sphere></geometry><surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface></collision>
      </link>
      <joint name="left_wheel_joint" type="revolute"><parent>chassis</parent><child>left_wheel</child><axis><xyz expressed_in="__model__">0 1 0</xyz></axis></joint>
      <joint name="right_wheel_joint" type="revolute"><parent>chassis</parent><child>right_wheel</child><axis><xyz expressed_in="__model__">0 1 0</xyz></axis></joint>
      <joint name="rear_caster_joint" type="fixed"><parent>chassis</parent><child>rear_caster</child></joint>
      <joint name="front_caster_joint" type="fixed"><parent>chassis</parent><child>front_caster</child></joint>
      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint><right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.36</wheel_separation><wheel_radius>0.1</wheel_radius>
        <topic>/model/minimal_robot/cmd_vel</topic><odom_topic>/model/minimal_robot/odometry</odom_topic>
        <frame_id>odom</frame_id><child_frame_id>minimal_robot/chassis</child_frame_id><odom_publish_frequency>30</odom_publish_frequency>
      </plugin>
    </model>
  </world>
</sdf>
